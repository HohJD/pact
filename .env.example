# OpenRouter API key for LLM + embedding calls
OPENROUTER_API_KEY=
# Chat model via OpenRouter (default: anthropic/claude-sonnet-4.5)
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
# Embedding model via OpenRouter (default: openai/text-embedding-3-small)
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
# Supabase project URL (client-safe)
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anon key (client-safe)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase service role key (server only, never expose)
SUPABASE_SERVICE_ROLE_KEY=
# Mapbox token for map rendering (client-safe). Optional — when unset the
# workspace renders the built-in SVG world map; when set it uses mapbox-gl
# (dark-v11) with an automatic SVG fallback on error.
NEXT_PUBLIC_MAPBOX_TOKEN=
# Data source: "seed" for bundled seed data, "supabase" for live DB (default: seed)
PACT_DATA_SOURCE=seed
